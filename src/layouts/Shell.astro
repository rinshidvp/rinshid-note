---
import '../styles/global.css';
import { site, publicLinks } from '../config/site';
import { pathFor, absoluteUrl } from '../lib/urls';
interface Props { title?: string; description?: string; language?: 'en' | 'ml'; article?: boolean; published?: Date; updated?: Date; noindex?: boolean; translation?: string; }
const { title, description = site.bio, language = 'en', article = false, published, updated, noindex = false, translation } = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : `${site.title} — ${site.name}`;
const current = Astro.url.pathname;
const canonical = new URL(current, site.url).href;
const isActive = (path: string) => path === '/' ? current === pathFor('/') : current.startsWith(pathFor(path));
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => { let theme = 'system'; try { theme = localStorage.getItem('notebook-theme') || 'system'; } catch {} document.documentElement.dataset.theme = theme === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : theme; })();
    </script>
    <title>{pageTitle}</title><meta name="description" content={description} />
    <meta name="theme-color" content="#FCF8F2" media="(prefers-color-scheme: light)" /><meta name="theme-color" content="#24201D" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href={pathFor('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={pathFor('/rss.xml')} />
    {translation && <><link rel="alternate" hreflang={language} href={canonical} /><link rel="alternate" hreflang={language === 'en' ? 'ml' : 'en'} href={absoluteUrl(`/writing/${translation}/`)} /></>}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:url" content={canonical} /><meta property="og:site_name" content={site.title} /><meta property="og:locale" content={language === 'ml' ? 'ml_IN' : 'en_IN'} />
    <meta name="twitter:card" content="summary" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}{updated && <meta property="article:modified_time" content={updated.toISOString()} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <header class="masthead" lang="en">
        <a class="wordmark" href={pathFor('/')}>{site.title}<span class="wordmark-dot">.</span></a>
        <div class="masthead-tools"><span class="masthead-note">{site.mastheadNote}</span>
          <label class="theme-control"><span class="sr-only">Appearance</span><select id="theme" aria-label="Appearance"><option value="system">System theme</option><option value="light">Light theme</option><option value="dark">Dark theme</option></select></label>
        </div>
      </header>
      <div class="page-grid">
        <aside class="rail" lang="en">
          <a class="monogram" href={pathFor('/')} aria-label="Rinshid’s notebook home">r<span>.</span></a>
          <p class="rail-name">{site.name}</p><p class="rail-bio">Notes on AI, learning,<br />and attention.</p>
          <nav aria-label="Main navigation"><ul>{site.navigation.map((link) => <li><a href={pathFor(link.path)} aria-current={isActive(link.path) ? 'page' : undefined}>{link.label}</a></li>)}</ul></nav>
          <nav class="secondary-nav" aria-label="Explore more"><ul>{site.secondary.map((link) => <li><a href={pathFor(link.path)} aria-current={isActive(link.path) ? 'page' : undefined}>{link.label}</a></li>)}</ul></nav>
          <nav class="secondary-nav" aria-label="Elsewhere"><ul>{publicLinks.filter((link) => link.platform === 'Portfolio').map((link) => <li><a href={link.url}>Portfolio <span aria-hidden="true">↗</span></a></li>)}</ul></nav>
          <p class="rail-location">From Kerala, India<br /><span lang="ml">പഠിച്ചുകൊണ്ടിരിക്കുന്നു.</span></p>
        </aside>
        <main id="main" tabindex="-1"><slot /></main>
      </div>
      <footer class="footer" lang="en"><div><a class="footer-mark" href={pathFor('/')}>r.</a><p>A small corner of the internet.<br />Made for learning, building, and sharing.</p></div><nav aria-label="Footer"><ul>{publicLinks.filter((link) => link.featured).map((link) => <li><a href={link.url}>{link.platform} <span aria-hidden="true">↗</span></a></li>)}{site.secondary.filter((link) => ['/guides/', '/videos/'].includes(link.path)).map((link) => <li><a href={pathFor(link.path)}>{link.label}</a></li>)}<li><a href={pathFor('/rss.xml')}>RSS</a></li><li><a href={pathFor('/links/')}>All links</a></li><li><a href={pathFor('/contact/')}>Say hello</a></li></ul></nav></footer>
    </div>
    <script>
      const select = document.querySelector<HTMLSelectElement>('#theme')!;
      let choice = 'system'; try { choice = localStorage.getItem('notebook-theme') || 'system'; } catch {}
      select.value = ['light', 'dark', 'system'].includes(choice) ? choice : 'system';
      const system = matchMedia('(prefers-color-scheme: dark)');
      function apply() { document.documentElement.dataset.theme = select.value === 'system' ? (system.matches ? 'dark' : 'light') : select.value; }
      select.addEventListener('change', () => { try { localStorage.setItem('notebook-theme', select.value); } catch {} apply(); });
      system.addEventListener('change', apply);
    </script>
  </body>
</html>
