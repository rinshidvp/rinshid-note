---
import Shell from '../layouts/Shell.astro';
import { publicLinks, site } from '../config/site';
import { pathFor } from '../lib/urls';
---
<Shell title="About" description={site.bio}>
  <header class="page-head"><p class="eyebrow">About &amp; links</p><h1>Hello, I’m Rinshid.</h1><p class="summary">{site.bio}</p></header>
  <article class="prose" id="about">
    <p>I’m <strong>{site.name}</strong>. This is my space for writing in English and Malayalam about things I’m learning and figuring out.</p>
    <p>For my projects, experience, and professional work, visit my portfolio below.</p>
  </article>
  <section class="section"><h2>Portfolio &amp; social media</h2><div class="link-row">{publicLinks.filter((link) => link.featured).map((link) => <a href={link.url}>{link.platform} ↗</a>)}<a href={pathFor('/contact/')}>Get in touch →</a></div></section>
</Shell>
